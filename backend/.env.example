# backend/.env.example — 이 파일을 backend/.env 로 복사한 뒤 실제 값을 채운다.
# backend/.env 는 .gitignore 로 제외되어 있으며 절대 커밋하지 않는다.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=godlife
DB_USERNAME=godlife_user
DB_PASSWORD=

AI_SERVER_URL=http://localhost:8000

# 서명 키. 32바이트 이상의 임의 문자열 (예: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=
# HTTPS 로 배포할 때만 true
JWT_REFRESH_COOKIE_SECURE=false

# 휴대폰 번호 해시(HMAC) 키. 32바이트 이상 임의 문자열. 한 번 정하면 바꾸지 않는다
PHONE_HMAC_SECRET=

# 소셜 로그인 앱 키. Redirect URI 는 http://localhost:5173/login/oauth2/code/{google|kakao|naver}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 카카오 client-id 는 REST API 키. Client Secret 은 콘솔에서 켜 둔 경우에만
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 결제 (포인트 충전, 토스페이먼츠 테스트 모드 전용). 비워 두면 화면에서 결제 버튼이 꺼진다.
# developers.tosspayments.com → 내 개발정보 → API 키 → "API 개별 연동 키"의 테스트 키 (test_ck_... / test_sk_...)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 메일 발송: demo(기본) / smtp(Gmail 실제 발송). smtp 일 때 Gmail 주소와 "앱 비밀번호"(계정 비밀번호 아님)
MAIL_MODE=demo
MAIL_USERNAME=
MAIL_PASSWORD=

# 푸시 알림(웹 푸시) VAPID 키 쌍. 비워 두면 푸시만 꺼진다.
# 만들기: node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();console.log('VAPID_PUBLIC_KEY='+e.getPublicKey('base64url'));console.log('VAPID_PRIVATE_KEY='+e.getPrivateKey('base64url'))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
